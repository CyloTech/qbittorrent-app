#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Send the pending Appbox installed callback once, then stay idle so s6 does
# not restart this service. A rejected callback is logged and not repeated.
# (With ENABLE_VUETORRENT=qui, appbox-qui.py sends it once qui is ready.)

if [[ -f /etc/appbox_callback_pending ]]; then
  /usr/local/bin/appbox-installed-callback
  rm -f /etc/appbox_callback_pending
fi

exec s6-pause
